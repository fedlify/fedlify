  @@unique([studyId, contentHash])
  @@index([workItemId])
}

model ApprovalBinding {
  id                 String                @id @default(cuid())
  studyId            String
  artifactRevisionId String
  artifactHash       String
  sourceCommit       String?
  policyVersion      String
  evidenceHash       String
  status             ApprovalBindingStatus @default(PENDING)
  approvedById       String?
  approvedAt         DateTime?
  expiresAt          DateTime?
  invalidatedAt      DateTime?
  invalidationReason String?
  // True when the approver is the requester (recorded, not blocked, in the shadow phase).
  selfApproved       Boolean               @default(false)
  version            Int                   @default(1)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([studyId, status])
  @@index([artifactRevisionId])
}

model VerificationRun {
  id                 String             @id @default(cuid())
  studyId            String
  workItemId         String?
  artifactRevisionId String
  kind               VerificationKind
  status             VerificationStatus @default(PENDING)
  verifier           String
  checks             Json
  findings           Json?
  inputHash          String
  outputHash         String?
  modelProfile       String?
  promptHash         String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime           @default(now())

  @@index([studyId, artifactRevisionId, kind])
  @@index([workItemId])
}

model ProvenanceEdge {
  id        String   @id @default(cuid())
  studyId   String
  fromType  String
  fromId    String
  fromHash  String
  toType    String
  toId      String
  toHash    String
  relation  String
  createdAt DateTime @default(now())

  @@unique([studyId, fromId, toId, relation])
  @@index([studyId, fromType, fromId])
  @@index([studyId, toType, toId])
}

model DependencyInvalidation {
  id           String             @id @default(cuid())
  studyId      String
  sourceType   String
  sourceId     String
  sourceHash   String
  targetType   String
  targetId     String
  reason       String
  status       InvalidationStatus @default(OPEN)
  detectedAt   DateTime           @default(now())
  resolvedById String?
  resolvedAt   DateTime?

  @@index([studyId, status])
  @@index([targetType, targetId])
}

model QuarantineRecord {
  id              String           @id @default(cuid())
  studyId         String
  sourceType      String
  sourceLocator   String
  contentHash     String
  reasonCodes     String[]
  status          QuarantineStatus @default(HELD)
  metadata        Json?
  quarantinedById String
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime         @default(now())

  @@index([studyId, status])
}

model ExportManifest {
  id                String   @id @default(cuid())
  studyId           String
  approvalBindingId String
  artifactIds       String[]
  manifest          Json
  manifestHash      String
  signature         String
  signatureKeyId    String
  credentialFree    Boolean  @default(true)
  exportedById      String
  createdAt         DateTime @default(now())

  @@unique([manifestHash])
  @@index([studyId, createdAt])
}

model MutationReceipt {
  id             String   @id @default(cuid())
  studyId        String
  actorUserId    String
  idempotencyKey String
  operation      String
  requestHash    String
  targetType     String
  targetId       String
  response       Json
  createdAt      DateTime @default(now())

  @@unique([studyId, actorUserId, idempotencyKey])
  @@index([studyId, operation, createdAt])
}

model AgentExecution {
  id                 String    @id @default(cuid())
  studyId            String
  workItemId         String
  role               String
  provider           String
  model              String
  reasoningEffort    String?
  promptHash         String
  evidenceHash       String
  outputHash         String?
  artifactRevisionId String?
  inputTokens        Int?
  outputTokens       Int?
  toolCalls          Int       @default(0)
  stopReason         String?
  verificationStatus String?
  startedAt          DateTime  @default(now())
  completedAt        DateTime?

  @@index([studyId, workItemId])
}

model ProbeRun {
  id              String         @id @default(cuid())
  studyId         String?
  suiteVersion    String
  suiteHash       String
  providerProfile String
  repetition      Int            @default(1)
  status          ProbeRunStatus @default(PENDING)
  sourceManifest  Json
  summary         Json?
  startedById     String
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  results         ProbeResult[]

  @@unique([suiteHash, providerProfile, repetition, createdAt])
  @@index([studyId, status])
}

model ProbeResult {
  id                    String           @id @default(cuid())
  probeRunId            String
  probeId               String
  disposition           ProbeDisposition
  expectedDisposition   String
  expectedBlockingLayer String
  observedBlockingLayer String?
  expectedStopCondition String?
  observedStopCondition String?
  criticalEscape        Boolean          @default(false)
  evidence              Json
  fixtureHash           String
  startedAt             DateTime?
  completedAt           DateTime?
  probeRun              ProbeRun         @relation(fields: [probeRunId], references: [id], onDelete: Cascade)

  @@unique([probeRunId, probeId])
  @@index([probeId, disposition])
}

model CaseStudyProtocol {
  id                 String             @id @default(cuid())
  studyId            String?
  version            Int                @default(1)
  protocolHash       String
  datasetHash        String
  datasetSchema      Json
  trainingHospitals  Int[]
  validationHospital Int
  expectedCounts     Json
  featureContract    Json
  preprocessing      Json
  jobSpecifications  Json
  status             CaseStudyRunStatus @default(DRAFT)
  approvedById       String?
  approvedAt         DateTime?
  createdById        String
  createdAt          DateTime           @default(now())
  runs               CaseStudyRun[]

  @@unique([protocolHash])
  @@index([studyId, status])
}

model CaseStudyRun {
  id             String             @id @default(cuid())
  protocolId     String
  algorithm      String
  seed           Int
  status         CaseStudyRunStatus @default(DRAFT)
  codeCommit     String?
  containerImage String?
  nvflareJobId   String?
  resultHash     String?
  failureReason  String?
  startedAt      DateTime?
  completedAt    DateTime?
  protocol       CaseStudyProtocol  @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  metrics        CaseStudyMetric[]

  @@unique([protocolId, algorithm, seed])
  @@index([status])
}

model CaseStudyMetric {
  id            String       @id @default(cuid())
  runId         String
  hospitalId    Int?
  split         String
  metric        String
  value         Float
  ciLower       Float?
  ciUpper       Float?
  baselineValue Float?
  difference    Float?
  metadata      Json?
  run           CaseStudyRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())

  @@unique([runId, hospitalId, split, metric])
  @@index([metric, split])
}

// --- Registry model (docs/site-runner-and-ux-design.md section 15) -----------------------------------------------
// One private Harbor project per study, and one pull-only Harbor robot per site kit. No column here can hold a robot
// secret: the secret goes into the encrypted kit and nowhere else. studyId and studySiteId are plain indexed strings,
// not foreign keys, on purpose: a deleted study or site must not delete the record that tells the sweeper which Harbor
// robots still need removing.
enum RegistryProjectStatus {
  ACTIVE
  RETIRED
}

enum RegistryRobotPurpose {
  SITE_PULL
}

enum RegistryRobotStatus {
  PENDING
  ACTIVE
  REVOKING
  DELETED
}

model RegistryProject {
  id         String                @id @default(cuid())
  studyId    String                @unique
  name       String                @unique
  status     RegistryProjectStatus @default(ACTIVE)
  quotaBytes BigInt?
  robots     RegistryRobot[]
  createdAt  DateTime              @default(now())
  retiredAt  DateTime?
}

model RegistryRobot {
  id                String               @id @default(cuid())
  registryProjectId String
  studySiteId       String?
  siteJoinPackageId String?
  purpose           RegistryRobotPurpose @default(SITE_PULL)
  harborRobotId     Int?
  harborName        String
  status            RegistryRobotStatus  @default(PENDING)
  expiresAt         DateTime
  // Sanitized (at most 200 characters), never a Harbor response body.
  lastError         String?
  registryProject   RegistryProject      @relation(fields: [registryProjectId], references: [id], onDelete: Cascade)
  createdAt         DateTime             @default(now())
  deletedAt         DateTime?

  @@index([studySiteId, status])
  @@index([status, createdAt])
  @@index([registryProjectId])
}
