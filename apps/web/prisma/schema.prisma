  purpose           String
  inputHash         String
  evidenceIds       String[]
  allowedTools      String[]
  tokenBudget       Int?
  timeBudgetSeconds Int?
  signature         String?
  signatureKeyId    String?
  version           Int            @default(1)
  expiresAt         DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
