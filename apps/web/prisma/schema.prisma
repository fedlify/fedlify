  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime   @default(now())

  @@index([studyId, key, status])
  @@index([workItemId])
}

model ProjectFact {
  id            String     @id @default(cuid())
  studyId       String
  proposalId    String?
  key           String
  value         Json
  valueHash     String
  sourceIds     String[]
  version       Int
  status        FactStatus @default(CONFIRMED)
  confirmedById String
  confirmedAt   DateTime   @default(now())
  supersedesId  String?
  invalidatedAt DateTime?

  @@unique([studyId, key, version])
  @@index([studyId, key, status])
}

model EvidenceRecord {
