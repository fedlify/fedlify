  studyId      String
  decisionType String
  decision     Json
  rationale    String
  evidenceIds  String[]
  artifactIds  String[]
  decisionHash String
  decidedById  String
  createdAt    DateTime @default(now())

  @@unique([decisionHash])
  @@index([studyId, decisionType, createdAt])
}

model ArtifactRevision {
  id             String   @id @default(cuid())
  studyId        String
  workItemId     String?
  artifactType   String
  revision       Int
  contentHash    String
  storageLocator String
  sourceCommit   String?
  policyVersion  String
  immutable      Boolean  @default(true)
  metadata       Json?
  createdById    String
  createdAt      DateTime @default(now())

