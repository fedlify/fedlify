\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Authorization path, write authorities and absent capabilities.} \textbf  {a}) Deterministic software controls every transition, and the bounded model scope permits reasoning without authority. \textbf  {b}) Six stores carry separate write authorities, so a model proposes and only a named authority establishes project truth. \textbf  {c}) Connections that are absent from the assistant by provisioning.}}{5}{figure.caption.3}\protected@file@percent }
\newlabel{fig:authpath}{{3}{5}{\textbf {Authorization path, write authorities and absent capabilities.} \textbf {a}) Deterministic software controls every transition, and the bounded model scope permits reasoning without authority. \textbf {b}) Six stores carry separate write authorities, so a model proposes and only a named authority establishes project truth. \textbf {c}) Connections that are absent from the assistant by provisioning}{figure.caption.3}{}}
