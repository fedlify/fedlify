\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Documented capability coverage across the operational lifecycle.} Each cell is one framework--requirement pair, scored 0 to 3 against the frozen evidence package. Columns are grouped by lifecycle category and rows are ordered by total coverage. The band above the heatmap gives normalized coverage for each category, and the marginal bars give normalized coverage per framework (right) and per requirement (below). Every marginal is computed from the same 406 cells and averages to 32.6\%. Coverage concentrates in federated protocol and execution control (C6) and thins toward the categories that govern how a study begins (C1, C2) and how it is sustained (C8). Values are the expert assessment.}}{3}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:coverage}{{1}{3}{\textbf {Documented capability coverage across the operational lifecycle.} Each cell is one framework--requirement pair, scored 0 to 3 against the frozen evidence package. Columns are grouped by lifecycle category and rows are ordered by total coverage. The band above the heatmap gives normalized coverage for each category, and the marginal bars give normalized coverage per framework (right) and per requirement (below). Every marginal is computed from the same 406 cells and averages to 32.6\%. Coverage concentrates in federated protocol and execution control (C6) and thins toward the categories that govern how a study begins (C1, C2) and how it is sustained (C8). Values are the expert assessment}{figure.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Fedlify within the multi-institutional health AI lifecycle. \textbf  {a}, A six-step process crosses three responsibility lanes. Institutions authorize the objective and approve the handoff; Fedlify supports planning and preparation; site engineers configure the approved runtime; and the FL runtime executes training before institutional validation, release, and operation. Monitoring, incidents, retraining, or material changes can reopen planning. \textbf  {b}, Fedlify structures requirements, requests approved site evidence, coordinates responsibilities and decisions, assesses readiness, and drafts a versioned handoff. Human approval remains outside the Fedlify boundary. Patient data and runtime credentials remain within participating institutions.}}{4}{figure.caption.2}\protected@file@percent }
\newlabel{fig:lifecycle}{{2}{4}{Fedlify within the multi-institutional health AI lifecycle. \textbf {a}, A six-step process crosses three responsibility lanes. Institutions authorize the objective and approve the handoff; Fedlify supports planning and preparation; site engineers configure the approved runtime; and the FL runtime executes training before institutional validation, release, and operation. Monitoring, incidents, retraining, or material changes can reopen planning. \textbf {b}, Fedlify structures requirements, requests approved site evidence, coordinates responsibilities and decisions, assesses readiness, and drafts a versioned handoff. Human approval remains outside the Fedlify boundary. Patient data and runtime credentials remain within participating institutions}{figure.caption.2}{}}
